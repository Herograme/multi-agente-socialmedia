{
  "name": "@social-content/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@social-content/shared": "workspace:*",
    "puppeteer": "^24.36.1",
    "sharp": "^0.33.0",
    "shiki": "^3.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@types/sharp": "^0.32.0",
    "image-size": "^2.0.2",
    "vitest": "^1.2.0"
  }
}
