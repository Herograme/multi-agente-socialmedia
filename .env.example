# ===========================================
# Social Content Agent - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database (SQLite file path)
DATABASE_PATH=./data/social-content.db

# ===========================================
# LLM Providers (GROQ_API_KEY is required)
# ===========================================

# Groq - LLM Provider (free tier: 30 req/min)
# Get your key at: https://console.groq.com/keys
# REQUIRED
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7

# ===========================================
# Image Generation Providers (IDEOGRAM_API_KEY is required)
# ===========================================

# Ideogram - Primary (free tier: 25 images/day)
# Get your key at: https://ideogram.ai
# REQUIRED
IDEOGRAM_API_KEY=
IDEOGRAM_STYLE=REALISTIC

# Leonardo.ai - Fallback (free tier: 150 tokens/day)
# Get your key at: https://leonardo.ai
# Optional - enables image fallback
LEONARDO_API_KEY=
LEONARDO_STYLE=CINEMATIC

# ===========================================
# Trend Sources (all enabled by default)
# ===========================================

# Dev.to API
DEVTO_ENABLED=true
DEVTO_URL=https://dev.to/api/articles

# Hacker News API
HACKERNEWS_ENABLED=true
HACKERNEWS_URL=https://hacker-news.firebaseio.com/v0

# Reddit (r/programming)
REDDIT_ENABLED=true
REDDIT_URL=https://www.reddit.com/r/programming.json

# ===========================================
# Quality Settings
# ===========================================

# Minimum score for posts (0-10)
QUALITY_THRESHOLD=6.0

# Automatically retry failed generations
QUALITY_AUTO_RETRY=true

# Max retries before giving up
QUALITY_MAX_RETRIES=3

# ===========================================
# WebSocket Configuration (Story 5.1)
# ===========================================

# Heartbeat interval in milliseconds (default: 30000)
WS_HEARTBEAT_INTERVAL=30000

# Pong timeout in milliseconds (default: 10000)
WS_PONG_TIMEOUT=10000

# Rate limit: messages per window (default: 60)
WS_RATE_LIMIT=60

# Rate limit window in milliseconds (default: 60000)
WS_RATE_WINDOW=60000

# ===========================================
# Frontend (packages/ui/.env.local)
# ===========================================

# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001
